set(SANITIZERS "" CACHE STRING "Comma-separated sanitizers to build with (e.g. address,undefined or thread)")
if(NOT SANITIZERS STREQUAL "")
    if(SANITIZERS MATCHES "thread" AND SANITIZERS MATCHES "address")
        message(FATAL_ERROR "The thread and address sanitizers cannot be combined")
    endif()
    if(MSVC)
        if(NOT SANITIZERS STREQUAL "address")
            message(FATAL_ERROR "MSVC only supports the address sanitizer, got '${SANITIZERS}'")
        endif()
        add_compile_options(/fsanitize=address /Zi)
    else()
        add_compile_options(-fsanitize=${SANITIZERS} -fno-omit-frame-pointer -g)
        add_link_options(-fsanitize=${SANITIZERS})
        if(SANITIZERS MATCHES "undefined")
            add_compile_options(-fno-sanitize-recover=undefined)
        endif()
    endif()
endif()
