# Command: `doxygen Doxyfile`.
# Output location: docs/html.

PROJECT_NAME           = "exchange"
PROJECT_BRIEF          = "Low-latency exchange in C++"
OUTPUT_DIRECTORY       = docs

INPUT                  = client common server
FILE_PATTERNS          = *.cpp *.h *.hpp
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# Requires graphviz `dot`
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

# Do not fail CI
QUIET                  = YES
WARN_AS_ERROR          = NO
