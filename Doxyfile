# Command: `doxygen Doxyfile`.
# Output location: docs/html.

PROJECT_NAME           = "exchange"
PROJECT_BRIEF          = "Low-latency exchange in C++"
OUTPUT_DIRECTORY       = docs

INPUT                  = README.md DIFFERENTIAL_TESTING.md FUZZING.md MUTATION_TESTING.md apps client common server
FILE_PATTERNS          = *.cpp *.h *.hpp
EXCLUDE_PATTERNS       = */test/*
USE_MDFILE_AS_MAINPAGE = README.md
IMAGE_PATH             = assets
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
INHERIT_DOCS           = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# Requires graphviz `dot`
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

# Do not fail CI
QUIET                  = YES
WARN_AS_ERROR          = NO
